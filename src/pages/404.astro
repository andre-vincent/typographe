---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
---

<BaseLayout title="Page introuvable" description="La page que vous avez demandée n’a pas pu être trouvée." noindex>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer grid min-h-[55vh] place-items-center py-16 text-center">
    <div>
      <p class="eyebrow">Erreur 404</p>
      <h1 class="pagehead-title">Page introuvable</h1>
      <p class="pagehead-description mx-auto">
        Cet article a peut-être été déplacé, ou l'adresse peut être mal tapée.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/" class="btn btn-solid">Retour à la page d’origine</a>
        <a href="/posts/" class="btn btn-outline">Parcourir l'archive</a>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
