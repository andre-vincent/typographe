---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
---

<BaseLayout title="Privacy" description={`Privacy policy for ${siteConfig.name}.`}>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">Confidentialité</p>
        <h1 class="pagehead-title">Politique de confidentialité</h1>
        <p class="pagehead-description">
          Exemple démarrage décrivant ce qu'une publication peut collecter et comment elle est utilisée. Remplacez-le par votre propre politique avant de mettre en ligne.
        </p>
      </header>

      <div class="prose">
        <h2>Ce qui est collecté</h2>
        <p>
          Ce site est généré de manière statique et n’installe pas de cookies propres. Si l’infolettre ou le formulaire de contact est connecté à un fournisseur, ce fournisseur reçoit les détails que vous soumettez.
        </p>

        <h2>Comment est-ce utilisé ?</h2>
        <p>
          Les détails soumis ne sont utilisés que pour vous répondre ou pour envoyer les courriels que vous avez demandés. Ils ne sont pas vendus ou partagés à des fins publicitaires.
        </p>

        <h2>Vos préférences de lecture</h2>
        <p>
          Le mode de lecture clair ou sombre que vous choisissez est stocké dans le stockage local de votre navigateur sous <code>typo-fr-theme</code>. Il demeure sur votre appareil et vous pouvez l’effacer à tout moment.       
        </p>

        <h2>Contact</h2>
        {
          siteConfig.email ? (
            <p>Pour les demandes concernant la confidentialité, envoyez un courriel à <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.</p>
          ) : (
            <p>Ajoutez une adresse de contact de confidentialité dans <code>src/config/site.ts</code> avant de mettre en ligne.</p>
          )
        }
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
