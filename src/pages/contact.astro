---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
const contact = siteConfig.contact;
const action = contact.action.trim();
const isEnabled = contact.enabled;
/* Aucun point de terminaison configuré : gardez le formulaire utilisable et confirmez la soumission localement
   plutôt que de poster la page nulle part. */
const isDemo = isEnabled && action.length === 0;
---

<BaseLayout title="Contact" description={`Contactez-nous à ${siteConfig.name}.`}>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">Contact</p>
        <h1 class="pagehead-title">Contactez-nous</h1>
        <p class="pagehead-description">
          Les corrections, les questions et les demandes se retrouvent toutes dans la même boîte de réception. {contact.responseTime}
        </p>
        {
          siteConfig.email && (
            <p class="mt-4 text-sm text-muted-foreground">
              Préférez-vous le courrier électronique ? Écrire à <a href={`mailto:${siteConfig.email}`} class="text-accent underline underline-offset-2">{siteConfig.email}</a>.
            </p>
          )
        }
      </header>

      <form
        class="grid gap-5"
        action={action || undefined}
        method={contact.method}
        data-contact-form={isDemo ? "" : undefined}
      >
        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="contact-name">Nom</label>
          <input id="contact-name" name="name" type="text" autocomplete="name" required disabled={!isEnabled} class="field" />
        </div>

        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="contact-email">Courriel</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" required disabled={!isEnabled} class="field" />
        </div>

        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="contact-message">Message</label>
          <textarea id="contact-message" name="message" rows="7" required disabled={!isEnabled} class="field resize-y"></textarea>
        </div>

        <div class="flex flex-wrap items-center gap-4">
          <button type="submit" disabled={!isEnabled} class="btn btn-solid">
            {isEnabled ? "Envoyer le message" : "Formulaire indisponible"}
          </button>
          <p class="contact-status text-sm leading-relaxed text-muted-foreground" role="status" aria-live="polite" data-contact-status></p>
        </div>

        {
          !isEnabled && (
            <p class="text-sm leading-relaxed text-muted-foreground">
              Ce formulaire est désactivé jusqu'à ce qu'un point de terminaison de formulaire soit configuré dans <code>siteConfig.contact</code>.
            </p>
          )
        }
      </form>
    </div>
  </main>
  <SiteFooter />

  {
    isDemo && (
      <script is:inline>
        document.querySelectorAll("[data-contact-form]").forEach((form) => {
          form.addEventListener("submit", (event) => {
            event.preventDefault();
            const status = form.querySelector("[data-contact-status]");
            if (status) {
              status.textContent =
                "Merci. Ce formulaire de démonstration n'est pas encore connecté à un point de terminaison, donc rien n'a été envoyé.";
            }
            form.reset();
          });
        });
      </script>
    )
  }

  <style>
    .contact-status:empty {
      display: none;
    }
  </style>
</BaseLayout>
