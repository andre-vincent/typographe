---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { authorSlug, getAllAuthors, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
const authors = getAllAuthors(allPosts);
---

<BaseLayout
  title="À propos"
  description={`À propos ${siteConfig.name} — ce qui publié et qui l’écrit.`}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">À propos</p>
        <h1 class="pagehead-title">{siteConfig.name}</h1>
        <p class="pagehead-description">{siteConfig.about}</p>
      </header>

      <div class="prose">
        <h2>Ce qui est publié ici</h2>
        <p>
          Articles, essais, notes longues sur divers sujets classés par catégories, sections ou chapitres. Les articles sont écrits pour être lus une fois, soigneusement, plutôt que d'être survolés.
        </p>

        <h2>Comment c'est écrit</h2>
        <p>
Chaque article vise à être reproductible et fiable. Si quelque chose est erroné ou incorrect, sur simple signalement à l’auteur, des corrections seront apportées le plus promptement possible, avec la date de mise à jour affichée en haut de l'article.
        </p>

        <h2>Qui écrit ici ?</h2>
        <ul>
          {
            authors.map((author) => (
              <li>
                <a href={`/author/${authorSlug(author.name)}/`}>{author.name}</a> — {author.role} ({author.posts.length} {author.posts.length === 1 ? "article" : "articles"})
              </li>
            ))
          }
        </ul>

        <h2>Contactez-nous</h2>
        <p>
          Les questions, les corrections et les demandes sont les bienvenues via la <a href="/contact/">page de contact</a>.
        </p>
        {
          siteConfig.email && (
            <p>Vous pouvez aussi poster un courriel directement à <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.</p>
          )
        }
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
